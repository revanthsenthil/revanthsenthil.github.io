ll,{"children":"Allowed, noncontradictory relation"}],["$","li",null,{"children":"Confidence ≥ 0.8"}],["$","li",null,{"children":"Two distinct consistent observations"}],["$","li",null,{"children":"Literal visual evidence"}]]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Skill completion"}],["$","ul",null,{"children":[["$","li",null,{"children":"Command-bound before/after views"}],["$","li",null,{"children":"Visible target and postcondition"}],["$","li",null,{"children":"Successful verdict with evidence"}],["$","li",null,{"children":"No contradiction"}],["$","li",null,{"children":"Current rollout ownership"}]]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Rejected evidence"}],["$","ul",null,{"children":[["$","li",null,{"children":"No queue advancement"}],["$","li",null,{"children":"Missing detection ≠ absence"}],["$","li",null,{"children":"Ambiguity ≠ success"}],["$","li",null,{"children":"Bounded retries, then review"}]]}]]}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"Verifier and observation paths"}],["$","p",null,{"children":["Frozen ",["$","a",null,{"className":"reference-link","href":"https://huggingface.co/Qwen/Qwen3-VL-4B-Instruct","target":"_blank","rel":"noopener noreferrer","children":"Qwen3-VL-4B-Instruct"}]," supports constrained decomposition and verification; ",["$","a",null,{"className":"reference-link","href":"https://huggingface.co/google/owlv2-base-patch16-ensemble","target":"_blank","rel":"noopener noreferrer","children":"OWLv2"}]," provides 2D proposals. Verification uses head/wrist views with temporally separated after frames. The grounded-relation path rejects duplicate/out-of-order observation IDs and requires repeated agreement with a minimum 0.25-second separation; geometric preconfirmation has its own gate. Confidence is a source score, not calibrated probability. Operator-grounded evidence has separate provenance. Ownership checks reject delayed responses for a different rollout, subgoal, or instruction."]}]]}]]}]
