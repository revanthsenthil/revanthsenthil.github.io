12:["$","section",null,{"className":"technical-section","id":"records","children":[["$","h2",null,{"children":[["$","span",null,{"children":"02"}]," What a record looks like"]}],["$","p",null,{"children":["An assertion record ",["$","$Lf",null,{"term":"r"}]," connects a proposition to its ",["$","strong",null,{"children":"evidence, confidence, support parents, and lifecycle status"}],". Active records form the supported state ",["$","$Lf",null,{"term":"S"}],"; the full record set ",["$","$Lf",null,{"term":"F"}]," retains inactive assertions too."]}],["$","aside",null,{"className":"method-equation","children":[["$","h3",null,{"children":"A record is more than a truth value"}],["$","div",null,{"className":"equation-lines","children":[["$","div",null,{"children":[["$","$Lf",null,{"term":"r"}]," = (",["$","$Lf",null,{"term":"phi"}],", ",["$","$Lf",null,{"term":"gamma"}],", ",["$","$Lf",null,{"term":"evidence"}],", ",["$","$Lf",null,{"term":"parents"}],", ",["$","$Lf",null,{"term":"status"}],")"]}],["$","div",null,{"children":[["$","$Lf",null,{"term":"S"}]," = ","{"," ",["$","$Lf",null,{"term":"phi"}]," ∣ ",["$","$Lf",null,{"term":"r"}]," ∈ ",["$","$Lf",null,{"term":"F"}],", ",["$","$Lf",null,{"term":"status"}]," = ",["$","span",null,{"className":"math-word","children":"active"}]," ","}"]}]]}],["$","p",null,{"className":"equation-example","children":["An assertion can remain in the record set after its support is withdrawn. ",["$","strong",null,{"children":"History is retained; current state is projected."}]]}]]}],["$","$L18",null,{}],["$","details",null,{"className":"reference-details","children":[["$","summary",null,{"children":"How the records join: evidence → event → fact → repair"}],["$","p",null,{"children":"Follow the references without duplicating the observation. These IDs belong only to the synthetic example above."}],["$","div",null,{"className":"reference-chain","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Evidence"}],["$","code",null,{"children":"frame_031 · frame_032"}],["$","small",null,{"children":"Referenced by the accepted event"}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"Event"}],["$","code",null,{"children":"e_remove"}],["$","small",null,{"children":"Records the negative containment delta"}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"Fact"}],["$","code",null,{"children":"f5 supersedes f1"}],["$","small",null,{"children":"f3 and f4 lose their required support"}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"Repair"}],["$","code",null,{"children":"repair_01"}],["$","small",null,{"children":"Restores the placement obligation"}]]}]]}],["$","p",null,{"children":[["$","code",null,{"children":"evidence_refs"}]," connect events to observations; ",["$","code",null,{"children":"supersedes_fact_ids"}]," connect new assertions to replaced records; ",["$","code",null,{"children":"depends_on_fact_ids"}]," connect conclusions to their support. Recovery history retains the triggering event reference."]}]]}],["$","div",null,{"className":"contract-grid","children":[["$","article",null,{"children":[["$","h3",null,{"children":"Truth ≠ status"}],["$","p",null,{"children":[["$","code",null,{"children":"value: false"}]," is a supported negative assertion. ",["$","code",null,{"children":"status: invalidated"}]," means support was withdrawn."]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Identity ≠ appearance"}],["$","p",null,{"children":[["$","code",null,{"children":"object_01"}]," persists across records. “Blue block” is a language label, not the database key."]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Direct ≠ derived"}],["$","p",null,{"children":["Direct facts name evidence. Derived facts also name required parents in ",["$","code",null,{"children":"depends_on_fact_ids"}],"."]}]]}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"Field conventions"}],["$","p",null,{"children":"Fact values: true / false / unresolved. Event deltas: true / false / unknown. Fact status: active / superseded / invalidated. Confidence is in [0,1], not calibrated probability. A derived spatial fact inherits the minimum confidence of its parents. Each record has one conjunctive support set: every listed parent is required. There is no alternative-justification manager that keeps the same record active when one parent fails; separately accepted evidence can create a new record."}]]}]]}]
