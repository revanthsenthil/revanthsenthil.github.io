"}]," = ",["$","span",null,{"className":"math-cases","children":[["$","span",null,{"children":[["$","span",null,{"className":"math-word","children":"insert"}],["$","sub",null,{"children":"next"}],"(",["$","$Lf",null,{"term":"Q"}],", ",["$","$Lf",null,{"term":"rho"}],") ",["$","small",null,{"children":["if ",["$","$Lf",null,{"term":"repairEntities"}]," ∩ ",["$","$Lf",null,{"term":"activeEntities"}]," ≠ ∅"]}]]}],["$","span",null,{"children":[["$","span",null,{"className":"math-word","children":"append"}],"(",["$","$Lf",null,{"term":"Q"}],", ",["$","$Lf",null,{"term":"rho"}],") ",["$","small",null,{"children":"otherwise"}]]}]]}]]}]}],["$","p",null,{"className":"equation-example","children":["Shared entities put repair immediately after the active skill. Otherwise it follows remaining work. Equivalent repairs are deduplicated; ",["$","strong",null,{"children":"the current instruction is not interrupted."}]]}]]}],["$","aside",null,{"className":"method-equation","children":[["$","h3",null,{"children":"Memory selects an instruction; the frozen policy acts"}],["$","div",null,{"className":"equation-lines","children":[["$","div",null,{"children":[["$","$Lf",null,{"term":"c"}]," = ",["$","span",null,{"className":"math-word","children":"active"}],"(",["$","$Lf",null,{"term":"Q"}],")"]}],["$","div",null,{"children":["(",["$","i",null,{"children":"y"}],["$","sub",null,{"children":"τ"}],", Â",["$","sub",null,{"children":"τ"}],["$","sup",null,{"children":"1:J"}],") = π",["$","sub",null,{"children":"G0.5"}],"(",["$","$Lf",null,{"term":"observations"}],", ",["$","$Lf",null,{"term":"c"}],", ",["$","i",null,{"children":"e"}],["$","sub",null,{"children":"R1"}],"; ",["$","$Lf",null,{"term":"weights"}],")"]}],["$","small",null,{"className":"math-key","children":[["$","span",null,{"children":[["$","i",null,{"children":"y"}],["$","sub",null,{"children":"τ"}],": optional reasoning tokens"]}],["$","span",null,{"children":[["$","span",null,{"className":"math-vector","children":"Â"}],["$","sub",null,{"children":"τ"}],["$","sup",null,{"children":"1:J"}],": action chunk"]}],["$","span",null,{"children":[["$","i",null,{"children":"J"}],": chunk length"]}],["$","span",null,{"children":[["$","i",null,{"children":"e"}],["$","sub",null,{"children":"R1"}],": robot embodiment identifier"]}]]}]]}],["$","p",null,{"className":"equation-example","children":["REMM dispatches one atomic instruction, such as “Place the blue block in the bowl.” G0.5 receives that text with its native observations and embodiment identifier. ",["$","strong",null,{"children":"The memory database stays outside the policy."}]]}]]}],["$","h3",null,{"children":"At the policy boundary"}],["$","$L19",null,{"value":{"instruction":"Place the blue block in the bowl.","other_inputs":["native multi-view observations","proprioception","robot embodiment identifier"]}}],"$L1a","$L1b"]}]
15:["$","section",null,{"className":"technical-section","id":"storage","children":[["$","h2",null,{"children":[["$","span",null,{"children":"05"}]," Storage and update contract"]}],["$","div",null,{"className":"storage-map","children":[["$","div","L · Ledger",{"children":[["$","strong",null,{"children":"L · Ledger"}],["$","span",null,{"children":"Append accepted events"}]]}],["$","div","F · Facts",{"children":[["$","strong",null,{"children":"F · Facts"}],["$","span",null,{"children":"Preserve records; revise status"}]]}],["$","div","D · Dependencies",{"children":[["$","strong",null,{"children":"D · Dependencies"}],["$","span",null,{"children":"Parent → consequence links"}]]}],["$","div","Q · Queue",{"children":[["$","strong",null,{"children":"Q · Queue"}],["$","span",null,{"children":"Edit pending work"}]]}]]}],["$","pre",null,{"className":"schema-line","children":"memory_items (key, type, payload, updated_at)"}],["$","p",null,{"className":"tiny-note","children":["Typed JSON in ",["$","a",null,{"className":"reference-link","href":"https://www.sqlite.org/","target":"_blank","rel":"noopener noreferrer","children":"SQLite"}],"; indexes by type and rollout."]}],["$","details",null,{"children":[["$","summary",null,{"children":"Consistency guarantees"}],["$","ul",null,{"children":[["$","li",null,{"children":"Same event ID and payload: idempotent replay. Changed payload under that ID: reject."}],["$","li",null,{"children":"Out-of-order timestamps: reject in the active projector."}],["$","li",null,{"children":"Inactive parent: cannot support a new derived fact."}],["$","li",null,{"children":"Projection failure: roll back database writes and restore process state."}],["$","li",null,{"children":"Nested updates: savepoints within an immediate transaction."}],["$","li",null,{"children":"Spatial-support cycle: reject."}]]}],["$","p",null,{"children":"Consistency does not establish perception accuracy. An atomic update can still store an incorrectly accepted observation."}]]}]]}]
16:["$","section",null,{"className":"technical-section","id":"evaluation","children":[["$","h2",null,{"children":[["$","span",null,{"children":"06"}]," Details behind the results"]}],["$","aside",null,{"className":"method-equation","children":[["$","h3",null,{"children":"Partial progress and full success answer different questions"}],["$","div",null,{"className":"equation-lines","children":[["$","div",null,{"children":[["$","$Lf",null,{"term":"P"}]," = ",["$","span",null,{"className":"math-fraction","children":[["$","span",null,{"children":"1"}],["$","span",null,{"children":[["$","i",null,{"children":"K"}],["$","sub",null,{"children":"e"}]]}]]}]," ∑",["$","sub",null,{"children":"m=1"}],["$","sup",null,{"children":"Kₑ"}]," ",["$","i",null,{"children":"y"}],["$","sub",null,{"children":"e,m"}]," ,　 ",["$","$Lf",null,{"term":"success"}]," = ∏",["$","sub",null,{"children":"m=1"}],["$","sup",null,{"children":"Kₑ"}]," ",["$","i",null,{"children":"y"}],["$","sub",null,{"children":"e,m"}]]}],["$","small",null,{"className":"math-key","children":["Kₑ: number of checkpoints · yₑ,ₘ ∈ ","{0, 1}",": whether checkpoint m is satisfied"]}]]}],["$","p",null,{"className":"equation-example","children":["Illustrative example: satisfying three of four checkpoints gives ",["$","strong",null,{"children":"75% progress"}],", but full-task success remains ",["$","strong",null,{"children":"0"}],". This is the checkpoint scoring definition; the reported export also contains recorded progress and missing-value fallbacks, detailed under physical results."]}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"Physical protocol · 51 trials"}],["$","p",null,{"children":"Matched instances, cameras, and workspace; external reset checks. T1 interventions follow full retraction. T2 orders are counterbalanced. T3 moves one cup at a time with pauses. Reported labels are drawn from the saved ledger and operator annotations, with camera evidence where available. Assisted trials remain included; unrecorded assistance is not evidence of autonomy. Model completion claims alone do not establish success."}],["$","p",null,{"children":"Progress, decision accuracy, partial completion, and full success are separate. Each rate excludes blank labels from its own denominator. Valid timeouts remain failures; wrong setup or missing required evidence may be unscorable."}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"Generated videos · 12 T2 + 30 T3 clips"}],["$","p",null,{"children":[["$","strong",null,{"children":"T2:"}]," endpoint-conditioned ",["$","a",null,{"className":"reference-link","href":"https://github.com/Lightricks/LTX-Video","target":"_blank","rel":"noopener noreferrer","children":"LTX-Video 0.9.8 13B Distilled"}],", using endpoint scene images from ",["$","a",null,{"className":"reference-link","href":"https://platform.openai.com/docs/guides/image-generation","target":"_blank","rel":"noopener noreferrer","children":"OpenAI image generation"}],". ",["$","strong",null,{"children":"T3:"}]," deterministic ",["$","a",null,{"className":"reference-link","href":"https://threejs.org/","target":"_blank","rel":"noopener noreferrer","children":"Three.js"}]," renders from the ",["$","a",null,{"className":"reference-link","href":"https://github.com/liutiedong/shellgame","target":"_blank","rel":"noopener noreferrer","children":"VET-Bench shell-game generator"}],". VET-Bench supplies the rendering pipeline, not a generative video model."]}],["$","p",null,{"children":"Matched clips with method-native observation selection and compute. Labels stay scorer-only. T2 grounding is open-vocabulary; T3 always uses left/middle/right. No G0.5 execution occurs. Additional revision and distractor tracks are unscored. Retained approval records lack reviewer-count and adjudication metadata."}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"Dependency controls and costs"}],["$","p",null,{"children":"Explicit invalidation reads broken-goal records. Recompute-on-demand checks saved postconditions against current direct facts. Direct-update-only changes relations without downstream broken-goal detection. A saved deterministic software fixture selects the same repair with explicit invalidation and recomputation; direct-update-only misses it in the state-query selector. A separate direct-reconciliation path can also recover it. This is a software control, not a physical ablation, and does not establish that propagation caused the pooled robot gains. Explicit links provide inspectable support provenance; behavioral superiority over recomputation is not demonstrated."}],"$L1c"]}],"$L1d"]}]
17:["$","footer",null,{"children":[["$","span",null,{"children":"REMM · Technical appendix"}],["$","a",null,{"href":"/remm/","children":"Project page →"}]]}]
1a:["$","p",null,{"className":"tiny-note","children":["Conceptual input summary, not an API payload. The frozen ",["$","a",null,{"className":"reference-link","href":"https://opengalaxea.github.io/G05/","target":"_blank","rel":"noopener noreferrer","children":"G0.5"}]," policy receives one instruction with native inputs. The database and support graph stay outside it."]}]
1b:["$","details",null,{"children":[["$","summary",null,{"children":"Queue scheduling and readout details"}],["$","p",null,{"children":"Repairs sharing entities with the active skill go immediately after it; otherwise they follow remaining nominal work. Equivalent repairs are deduplicated. Pending destinations can change, but the active instruction remains fixed until a verified stationary boundary."}],["$","p",null,{"children":["Offline T2 uses eight sampled views and frozen-VLM detections; offline T3 initializes a pixel-based binding and uses ",["$","a",null,{"className":"reference-link","href":"https://docs.opencv.org/4.13.0/d0/d26/classcv_1_1TrackerMIL.html","target":"_blank","rel":"noopener noreferrer","children":"MIL tracking"}],". These differ from the physical observation paths. Active-fact retrieval includes support ancestors for audit, not learned attention or memory-token injection."]}]]}]
1c:["$","p",null,{"children":"Time excludes setup and later labeling. Queries count fresh G0.5 action chunks, excluding supervisory VLM inference. Medians use available records only; T2 baseline cost coverage is two of five trials for each baseline. Early failure may appear cheaper than successful recovery. Logical memory traffic counts serialized writes and retrievals separately from camera streams, audit videos, and model weights. Cost efficiencies normalize against the best task-specific median."}]
1d:["$","details",null,{"children":[["$","summary",null,{"children":"Scope and provenance"}],["$","p",null,{"children":"Examples use synthetic IDs and inspected release-candidate schema fields. Support rules are compiler-supplied, not learned causal discovery. Symbolic locations and 2D boxes are not metric 3D reconstruction. Complete identity loss, appearance shift, and unrestricted occlusion remain limitations. The plotted ledger retains missing fields and some unresolved review-status annotations. Per-trial assistance, scoring provenance, and historical controller settings require reconciliation before a clean autonomous-only comparison or mechanism ablation can be claimed."}]]}]
