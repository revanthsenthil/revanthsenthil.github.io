1:[["$","a",null,{"className":"skip","href":"#video","children":"Skip to content"}],["$","header",null,{"className":"site-header","children":[["$","a",null,{"href":"#overview","className":"site-name","children":"REMM"}],["$","nav",null,{"aria-label":"Page sections","children":[["$","a",null,{"href":"#results","children":"Results"}],["$","a",null,{"href":"/remm/appendix/","children":"Appendix"}]]}],["$","$Ld",null,{}]]}],["$","main",null,{"children":[["$","section",null,{"className":"paper-header","id":"overview","children":[["$","h1",null,{"className":"project-title","children":[["$","span",null,{"className":"project-wordmark","children":"REMM"}],["$","span",null,{"className":"project-expansion","children":["Revisable Embodied Memory",["$","br",null,{}],"for Manipulation"]}]]}],["$","div",null,{"className":"author-block","children":[["$","p",null,{"className":"author-list","children":[["$","span",null,{"children":["Revanth Krishna Senthilkumaran",["$","sup",null,{"children":"1,2"}]]}],["$","span",null,{"children":["Ruwan Wickramarachchi",["$","sup",null,{"children":"2"}]]}],["$","span",null,{"children":["Alessandro Oltramari",["$","sup",null,{"children":"1,2"}]]}],["$","span",null,{"children":["Jonathan Francis",["$","sup",null,{"children":"1,2"}]]}]]}],["$","div",null,{"className":"affiliation-logos","aria-label":"Author affiliations","children":[["$","a",null,{"className":"affiliation","href":"https://www.cmu.edu/","children":[["$","span",null,{"className":"affiliation-logo","children":["$","img",null,{"className":"cmu-logo","src":"/remm/logos/cmu.png","width":"150","height":"150","alt":"Carnegie Mellon University logo"}]}],["$","span",null,{"children":[["$","sup",null,{"children":"1"}]," Carnegie Mellon University"]}]]}],["$","a",null,{"className":"affiliation","href":"https://www.bosch.com/","children":[["$","span",null,{"className":"affiliation-logo","children":["$","img",null,{"className":"bosch-logo","src":"/remm/logos/bosch.svg","width":"245","height":"55","alt":"Bosch logo"}]}],["$","span",null,{"children":[["$","sup",null,{"children":"2"}]," Bosch Center for AI"]}]]}]]}]]}],["$","div",null,{"className":"resource-links","aria-label":"Project resources","children":["$","a",null,{"href":"/remm/remm-paper.pdf","children":[["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":[["$","path",null,{"d":"M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8l-5-5Z","stroke":"currentColor","strokeWidth":"1.7","strokeLinejoin":"round"}],["$","path",null,{"d":"M14 3v5h5M8 12h8M8 16h6","stroke":"currentColor","strokeWidth":"1.7","strokeLinecap":"round"}]]}],["$","span",null,{"children":"Paper"}]]}]}],["$","p",null,{"className":"tldr","children":[["$","strong",null,{"children":"TL;DR"}]," REMM links visual evidence to revisable task state, allowing a robot to update its memory and schedule recovery around a frozen manipulation policy."]}]]}],["$","section",null,{"className":"paper-section prose","id":"video","children":[["$","h2",null,{"children":"Video overview"}],["$","video",null,{"className":"overview-video","controls":true,"playsInline":true,"preload":"metadata","poster":"/remm/videos/remm-overview-poster.jpg","aria-label":"REMM project overview and experiments","children":[["$","source",null,{"src":"/remm/videos/remm-overview.mp4","type":"video/mp4"}],"Your browser does not support embedded video."]}],["$","p",null,{"className":"section-caption","children":"A three-minute overview of REMM, physical task demonstrations, and evaluation. Subtitles are included in the video."}]]}],["$","section",null,{"className":"paper-section prose","id":"abstract","children":[["$","h2",null,{"children":"Abstract"}],["$","p",null,{"children":["History-dependent manipulation requires a robot to distinguish ",["$","strong",null,{"children":"what happened earlier"}],", ",["$","strong",null,{"children":"what remains true"}],", and ",["$","strong",null,{"children":"what still needs to be done"}],". A previously verified placement can become invalid after an object moves, while the event itself remains part of the task’s history. Retaining observations alone does not resolve these changes."]}],["$","p",null,{"children":["REMM is an external, evidence-linked memory and supervisory-control layer for a frozen manipulation policy. It separates historical events from revisable current assertions, propagates loss of support through explicit dependencies, and inserts targeted recovery skills into a task queue. The executor receives one bounded instruction at a time. Across 51 physical trials, including operator-assisted runs, REMM raises mean recorded progress over the best baseline from ","$Le"," on intervention recovery and from ","$Lf"," on sequence recall. Matched generated-video diagnostics further separate remembering history from grounding it into an executable instruction."]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15"]
