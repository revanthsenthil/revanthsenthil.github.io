3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"REMM — Revisable Embodied Memory for Manipulation"}],["$","meta","1",{"name":"description","content":"Evidence-linked memory and supervisory control for history-dependent robot manipulation."}],["$","meta","2",{"property":"og:title","content":"REMM: Revisable Embodied Memory for Manipulation"}],["$","meta","3",{"property":"og:description","content":"Robots that revise memory when the world changes."}],["$","meta","4",{"property":"og:url","content":"https://revanthsenthil.github.io/remm/"}],["$","meta","5",{"property":"og:site_name","content":"REMM"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"property":"og:image","content":"https://revanthsenthil.github.io/remm/figures/teaser.png"}],["$","meta","8",{"property":"og:image:width","content":"1190"}],["$","meta","9",{"property":"og:image:height","content":"600"}],["$","meta","10",{"property":"og:image:alt","content":"REMM revises a disturbed task condition and schedules recovery."}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"REMM: Revisable Embodied Memory for Manipulation"}],["$","meta","13",{"name":"twitter:description","content":"Robots that revise memory when the world changes."}],["$","meta","14",{"name":"twitter:image","content":"https://revanthsenthil.github.io/remm/figures/teaser.png"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":[]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple C