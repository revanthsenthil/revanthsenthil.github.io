23:["$","section",null,{"className":"paper-section","id":"generated","children":[["$","h2",null,{"children":"Generated-video experiments"}],["$","div",null,{"className":"prose","children":["$","p",null,{"children":["The matched diagnostic contains ",["$","strong",null,{"children":"12 T2 sequence clips and 30 T3 cup-shuffle clips"}],". Every method receives the same clips without manifest-derived answers. These experiments evaluate ",["$","strong",null,{"children":"memory readout and high-level command generation"}],", not physical manipulation success."]}]}],["$","div",null,{"className":"prose","children":[["$","h3",null,{"children":"How the videos were created"}],["$","p",null,{"children":[["$","strong",null,{"children":["T2 · ",["$","a",null,{"className":"reference-link","href":"https://github.com/Lightricks/LTX-Video","target":"_blank","rel":"noopener noreferrer","children":"LTX-Video 0.9.8 13B Distilled"}],"."]}]," Sequence clips use endpoint-conditioned video generation, with endpoint scene images produced using ",["$","a",null,{"className":"reference-link","href":"https://platform.openai.com/docs/guides/image-generation","target":"_blank","rel":"noopener noreferrer","children":"OpenAI image generation"}],"."]}],["$","p",null,{"children":[["$","strong",null,{"children":["T3 · ",["$","a",null,{"className":"reference-link","href":"https://github.com/liutiedong/shellgame","target":"_blank","rel":"noopener noreferrer","children":"VET-Bench shell-game generator"}],"."]}]," Cup-shuffle clips are deterministic ",["$","a",null,{"className":"reference-link","href":"https://threejs.org/","target":"_blank","rel":"noopener noreferrer","children":"Three.js"}]," renders, rather than outputs of a generative video model. Generation prompts, seeds, trajectories, and labels are withheld from the evaluated methods."]}]]}],["$","div",null,{"className":"prose","children":[["$","h3",null,{"children":"Models used to evaluate the videos"}],["$","p",null,{"children":["The matched compa